# Database - Local PostgreSQL with pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/biztechbot
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=100

# DeepSeek LLM Credentials
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ERPNext Integration
ERPNEXT_URL=https://bizcentraldemo.biztechnosys.in
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret
ERPNEXT_SSL_VERIFY=true

# RAG & Embedding Tuning
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=2400
CHUNK_OVERLAP=400

# Similarity Thresholds
SIMILARITY_THRESHOLD_KNOWLEDGE=0.25
SIMILARITY_THRESHOLD_MEMORY=0.55
SIMILARITY_THRESHOLD_EPISODIC=0.55
EPISODIC_DEDUPLICATION_THRESHOLD=0.85

# Conversational settings
MINDFUL_TALK_TURNS=2

# Crawler Settings
CRAWL_BASE_URL=https://beta.biztechnosys.com/
CRAWL_INTERVAL_HOURS=6
CRAWL_MAX_PAGES=500
CRAWL_MAX_DEPTH=10
CRAWL_CONCURRENT_WORKERS=5

# Security & Operations
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://beta.biztechnosys.com,http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO
DEBUG=false

# Azure App Registration & Outlook Integration
AZURE_TENANT_ID=biztechnosys.com
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
OUTLOOK_EMAIL=chethana@biztechnosys.com
